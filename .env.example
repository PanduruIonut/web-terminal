# Provisioned automatically when an Upstash Redis store is connected to the
# project via the Vercel marketplace integration. Pull them locally with:
#   vercel env pull .env
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Equivalent names, used if the store was created straight from the Upstash
# console instead of through Vercel. Either pair works.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
